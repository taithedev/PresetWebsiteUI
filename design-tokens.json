{
  "name": "Preset UI Studio",
  "version": "2.0.0",
  "repository": "https://github.com/taithedev/PresetWebsiteUI",
  "description": "Machine-readable aesthetic and component token reference, not a runtime API.",
  "studio": {
    "background": "#090a10",
    "surface": "#11121c",
    "surface2": "#181925",
    "surface3": "#222333",
    "text": "#f3f3f8",
    "subtle": "#a3a2b8",
    "muted": "#747589",
    "border": "rgba(210,205,255,.105)",
    "borderStrong": "rgba(210,205,255,.19)",
    "accent": "#b39bff",
    "accentRgb": "179 155 255",
    "radiusPx": 16,
    "ease": "cubic-bezier(.22,1,.36,1)",
    "fonts": {
      "display": "Space Grotesk",
      "body": "DM Sans"
    }
  },
  "exportableKit": {
    "background": "#10111c",
    "text": "#f5f4fc",
    "muted": "#9899b0",
    "surface": "#191a28",
    "border": "#ffffff22",
    "accent": "#ad96ff",
    "accentRgb": "173 150 255",
    "radiusPx": 13,
    "bloom": 0.55,
    "stylePath": "assets/css/kit.css",
    "scriptPath": "assets/js/kit-interactions.js"
  },
  "playgroundAccents": {
    "violet": {
      "hex": "#b39bff",
      "rgb": "179 155 255"
    },
    "cyan": {
      "hex": "#6bdcf2",
      "rgb": "107 220 242"
    },
    "rose": {
      "hex": "#ff8cb7",
      "rgb": "255 140 183"
    },
    "mint": {
      "hex": "#91e3bb",
      "rgb": "145 227 187"
    },
    "gold": {
      "hex": "#f7c37e",
      "rgb": "247 195 126"
    }
  },
  "layout": {
    "sidebarPx": 246,
    "topbarPx": 72,
    "maxWidthPx": 1600,
    "mobileMaxPx": 680,
    "tabletMaxPx": 890,
    "compactDesktopMaxPx": 1170,
    "minViewportPx": 320
  },
  "motion": {
    "hoverMs": [
      180,
      320
    ],
    "revealMs": [
      500,
      800
    ],
    "ambientSeconds": [
      6,
      12
    ],
    "reducedMotionSupported": true
  },
  "catalog": {
    "components": 30,
    "patterns": 4,
    "dataFiles": [
      "assets/data/buttons.js",
      "assets/data/forms.js",
      "assets/data/navigation.js",
      "assets/data/feedback.js",
      "assets/data/surfaces.js",
      "assets/data/patterns.js"
    ],
    "categories": [
      "Buttons",
      "Forms",
      "Navigation",
      "Feedback",
      "Surfaces",
      "Patterns"
    ]
  },
  "features": {
    "codeInspector": true,
    "htmlCssJsExport": true,
    "zipExport": true,
    "tokenExport": true,
    "search": true,
    "favorites": true,
    "customJsonImport": true,
    "localFileWorkspace": true,
    "remoteFileSync": false
  }
}
